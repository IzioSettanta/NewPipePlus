<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name="org.schabi.newpipe.api.ApiApp"
        android:allowBackup="false"
        android:label="NewPipe API"
        android:supportsRtl="true"
        android:theme="@style/Theme.NewPipeApi">

        <activity
            android:name="org.schabi.newpipe.external.TestSearchActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="org.schabi.newpipe.external.SearchReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.schabi.newpipe.SEARCH_REQUEST" />
            </intent-filter>
        </receiver>

        <service
            android:name="org.schabi.newpipe.external.ApiSearchService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="org.schabi.newpipe.action.SEARCH" />
            </intent-filter>
        </service>

    </application>

</manifest>
